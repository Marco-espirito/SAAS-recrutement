# Remplacer uniquement au moment de connecter les services réels.
OPENAI_API_KEY=REMPLACER_PAR_VOTRE_CLE_API
JOBS_PROVIDER_API_KEY=REMPLACER_PAR_VOTRE_CLE_API
EMAIL_PROVIDER_API_KEY=REMPLACER_PAR_VOTRE_CLE_API

# Assistant Nexora AI (app/api/assistant/route.ts) — clé lue uniquement
# côté serveur, jamais exposée au navigateur. Sans elle, l'assistant
# retombe automatiquement sur ses réponses de démonstration hors-ligne.
GEMINI_API_KEY=REMPLACER_PAR_VOTRE_CLE_API
# Optionnel : change le modèle appelé (par défaut gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash
