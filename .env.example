# Socle Nexora
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
POSTGRES_APP_USER=nexora_app
POSTGRES_APP_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://nexora_app:CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE@localhost:5432/nexora
APP_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=organizations
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SESSION_COOKIE_NAME=nexora_session
SESSION_TTL_DAYS=30
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
REQUIRE_EMAIL_VERIFICATION=false

# IA — clé(s) exclusivement côté serveur. L'interface demande un consentement explicite.
# AI_PROVIDER force le fournisseur (openai|gemini) ; sinon Gemini est utilisé si GEMINI_API_KEY
# est renseignée, sinon OpenAI si OPENAI_API_KEY est renseignée.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Intégrations optionnelles
JOBS_PROVIDER_URL=
JOBS_PROVIDER_API_KEY=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
CALENDAR_PROVIDER_URL=
CALENDAR_PROVIDER_API_KEY=

# Facturation Stripe — voir docs/BILLING.md pour la checklist de configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Cron Vercel (voir docs/OBSERVABILITY.md) : chaîne aléatoire d'au moins 16 caractères.
CRON_SECRET=
