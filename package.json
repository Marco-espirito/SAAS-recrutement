{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-worker.mjs && next dev",
    "build": "node scripts/prepare-pdf-worker.mjs && next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-identity.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx scripts/worker.ts",
    "build:vercel": "node scripts/prepare-pdf-worker.mjs && next build",
    "dev:vercel": "node scripts/prepare-pdf-worker.mjs && next dev",
    "docker:build": "docker build -t nexora:latest .",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "16.3.5",
    "openai": "^7.20.0",
    "pdfjs-dist": "^6.3.289",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
